# Actionlint Workflow Configuration Template
# Workflow: .github/workflows/actionlint.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom GitHub Actions runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_RUNNER=
INPUT_SHELLCHECK=false
INPUT_PYFLAKES=false

# Secrets (None required for actionlint)
