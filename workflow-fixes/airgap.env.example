# Airgap Image Tarballs Workflow Configuration Template
# Workflow: .github/workflows/airgap.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom GitHub Actions runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_ARCH=amd64
INPUT_RUNNER=
INPUT_DRY_RUN=false

# Secrets (None required for airgap workflow)
