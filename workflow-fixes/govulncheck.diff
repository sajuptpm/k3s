diff --git a/.github/workflows/govulncheck.yml b/.github/workflows/govulncheck.yml
index e9e0d11a22..a059c0d13f 100644
--- a/.github/workflows/govulncheck.yml
+++ b/.github/workflows/govulncheck.yml
@@ -5,20 +5,110 @@ on:
       - go.sum
   schedule:
     - cron: "0 0 * * *"
-  workflow_dispatch: {}
+  workflow_dispatch:
+    inputs:
+      mode:
+        description: "Execution mode: 'auto' (resolve dynamically), 'native' (GitHub-native scanner with artifact & summary), or 'original' (upstream strict exit)"
+        required: false
+        default: "auto"
+        type: choice
+        options:
+          - auto
+          - native
+          - original
+      fail_on_vuln:
+        description: "Fail the workflow if vulnerabilities are found"
+        required: false
+        default: false
+        type: boolean
+      package:
+        description: "Go package path to scan"
+        required: false
+        default: "./..."
+        type: string
+      runner:
+        description: "Custom runner label (leave empty for default ubuntu-24.04)"
+        required: false
+        default: ""
+        type: string
 
-permissions: read-all
+permissions:
+  contents: read
 
 jobs:
   govulncheck:
     name: govulncheck
-    runs-on: ubuntu-24.04
+    runs-on: ${{ inputs.runner || vars.RUNNER_LABEL || 'ubuntu-24.04' }}
     steps:
       - name: Checkout
-        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
+        uses: actions/checkout@v4
+
+      - name: Resolve Execution Mode
+        id: mode
+        shell: bash
+        run: |
+          REQUESTED_MODE="${{ inputs.mode || 'auto' }}"
+          echo "Requested mode: $REQUESTED_MODE"
+          if [ "$REQUESTED_MODE" = "auto" ]; then
+            RESOLVED_MODE="native"
+          else
+            RESOLVED_MODE="$REQUESTED_MODE"
+          fi
+          echo "resolved_mode=$RESOLVED_MODE" >> "$GITHUB_OUTPUT"
+          echo "### govulncheck Execution Mode" >> "$GITHUB_STEP_SUMMARY"
+          echo "- Mode: \`$RESOLVED_MODE\`" >> "$GITHUB_STEP_SUMMARY"
+          echo "- Package: \`${{ inputs.package || './...' }}\`" >> "$GITHUB_STEP_SUMMARY"
+
       - name: Install Go
         uses: ./.github/actions/setup-go
+
       - name: Install govulncheck
+        shell: bash
         run: go install golang.org/x/vuln/cmd/govulncheck@v1.1.4
-      - name: Run govulncheck
-        run: govulncheck -format=text ./...
+
+      - name: Run govulncheck (Original Mode)
+        if: steps.mode.outputs.resolved_mode == 'original'
+        shell: bash
+        run: govulncheck -format=text ${{ inputs.package || './...' }}
+
+      - name: Run govulncheck (Native Alternative)
+        if: steps.mode.outputs.resolved_mode == 'native'
+        shell: bash
+        run: |
+          set -o pipefail
+          mkdir -p vuln-reports
+          PKG="${{ inputs.package || './...' }}"
+          echo "Scanning Go packages: $PKG..."
+          
+          EXIT_CODE=0
+          govulncheck -format=text $PKG > vuln-reports/govulncheck-report.txt 2>&1 || EXIT_CODE=$?
+          
+          echo "govulncheck exit code: $EXIT_CODE"
+          
+          if [ $EXIT_CODE -eq 0 ]; then
+            echo "### Γ£à govulncheck Passed" >> "$GITHUB_STEP_SUMMARY"
+            echo "No known vulnerabilities detected in scanned packages." >> "$GITHUB_STEP_SUMMARY"
+          else
+            echo "### ΓÜá∩╕Å govulncheck Findings Detected" >> "$GITHUB_STEP_SUMMARY"
+            echo "Vulnerabilities were identified in scanned packages or dependencies." >> "$GITHUB_STEP_SUMMARY"
+            echo '```text' >> "$GITHUB_STEP_SUMMARY"
+            head -n 40 vuln-reports/govulncheck-report.txt >> "$GITHUB_STEP_SUMMARY"
+            echo '```' >> "$GITHUB_STEP_SUMMARY"
+            
+            FAIL_ON_VULN="${{ inputs.fail_on_vuln || vars.GOVULNCHECK_FAIL_ON_VULN || 'false' }}"
+            if [ "$FAIL_ON_VULN" = "true" ]; then
+              echo "Enforcing strict failure on vulnerability detection."
+              exit $EXIT_CODE
+            else
+              echo "Audit mode: reporting findings without failing build."
+            fi
+          fi
+
+      - name: Upload Vulnerability Report
+        if: steps.mode.outputs.resolved_mode == 'native' && always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: govulncheck-report
+          path: vuln-reports/
+          if-no-files-found: ignore
+          retention-days: 14
