# ==============================================================================
# Environment Configuration Template for trivy-trigger.yml
# Workflow: Trivy Scan Trigger
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io or 'native' on forks
# - native: Fork-friendly permission verification and lightweight dry-run image packaging
# - original: Upstream k3s-io organization membership verification
INPUT_MODE=auto

# Optional mock PR number for packaging context
INPUT_PR_NUMBER=1

# Dry Run: Package lightweight test image instead of full K3s build from source
INPUT_DRY_RUN=true

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345
