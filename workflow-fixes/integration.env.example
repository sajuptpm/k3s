# Integration Test Coverage Workflow Configuration Template
# Workflow: .github/workflows/integration.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Heavy push build control: false by default to conserve minutes on commit pushes
VARS_ENABLE_HEAVY_PUSH_BUILDS=false

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_ITEST=startup
INPUT_RUN_WINDOWS=false
INPUT_RUNNER=
INPUT_DRY_RUN=false

# Repository Secrets (Optional)
# CODECOV_TOKEN: Token for uploading test coverage to Codecov (safely bypassed if omitted)
CODECOV_TOKEN=
