# ==============================================================================
# Environment Configuration Template for updatecli.yaml
# Workflow: Updatecli Dependency Management
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io schedule or 'native' on forks/dispatch
# - native: Run 'updatecli pipeline diff' (safe preview without opening PRs or creating branches)
# - original: Run 'updatecli pipeline apply' (opens PRs and pushes branches)
INPUT_MODE=auto

# Target branch: 'main' | 'release-1.37' | 'release-1.36' | 'release-1.35' | 'release-1.34' | 'all'
INPUT_BRANCH=main

# Dry Run: Run diff instead of apply (default: true for non-destructive testing)
INPUT_DRY_RUN=true

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345

# Optional dedicated bot PAT with repo & PR write permissions (Original Mode)
SECRET_UPDATECLI_BOT_TOKEN=
