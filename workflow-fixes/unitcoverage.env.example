# ==============================================================================
# Environment Configuration Template for unitcoverage.yaml
# Workflow: Unit Test Coverage Pipeline
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io or 'native' on forks
# - native: GitHub-native coverage artifacts and step summary
# - original: Upstream Codecov dashboard upload
INPUT_MODE=auto

# Dry Run: Fast unit test execution and coverage simulation (default: true)
INPUT_DRY_RUN=true

# Execute Windows unit test suite (consumes 2x runner minutes)
INPUT_RUN_WINDOWS=false

# Execute Docker-based K8s modules tests
INPUT_RUN_TEST_MODS=false

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345

# Optional Codecov upload token (Original Mode only)
SECRET_CODECOV_TOKEN=
