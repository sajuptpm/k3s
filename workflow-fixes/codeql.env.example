# CodeQL Static Analysis Workflow Configuration Template
# Workflow: .github/workflows/codeql.yml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom GitHub Actions runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_LANGUAGE=actions
INPUT_RUNNER=
INPUT_UPLOAD_SARIF=true

# Secrets (None required; standard GITHUB_TOKEN used for code scanning security-events)
