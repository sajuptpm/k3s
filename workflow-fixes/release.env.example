# ==============================================================================
# Environment Configuration Template for release.yml
# Workflow: K3s Release Pipeline
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io or 'native' on forks
# - native: 100% GitHub-native pipeline (GHCR, GitHub Releases, Local/Actions Artifacts)
# - original: Upstream SUSE/Rancher Vault, Prime S3, and staging registries
INPUT_MODE=auto

# Release Tag Name (e.g., v1.32.4-rc1+k3s1 or v0.0.0-test)
INPUT_TAG=v0.0.0-test

# Dry Run: When true, builds/mocks and validates asset bundles without pushing to external registries or publishing release
INPUT_DRY_RUN=true

# Push container images to GHCR / DockerHub (only effective if dry_run=false)
INPUT_PUSH_IMAGES=false

# Create GitHub Pre-Release with attached assets (only effective if dry_run=false)
INPUT_CREATE_RELEASE=false

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345

# Optional DockerHub credentials (for publishing container images in Native Mode)
SECRET_DOCKER_USERNAME=
SECRET_DOCKER_TOKEN=

# Optional downstream upgrade dispatch PAT (for triggering k3s-upgrade repo)
SECRET_K3S_UPGRADE_PAT=

# Upstream Enterprise Secrets (Original Mode only - retrieved from Vault in upstream)
SECRET_AWS_ACCESS_KEY_ID=
SECRET_AWS_SECRET_ACCESS_KEY=
SECRET_PRIME_ARTIFACTS_BUCKET_NAME=
