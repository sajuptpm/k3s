# ==============================================================================
# Environment Configuration Template for trivy-scan.yml
# Workflow: Trivy Scan Result
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io or 'native' on forks
# - native: GitHub-native artifact & step summary reporting
# - original: Upstream PR comment and label removal
INPUT_MODE=auto

# Optional target PR number (leave empty for standalone security scan)
INPUT_PR_NUMBER=

# Dry Run: Generate scan report and step summary without posting PR comments
INPUT_DRY_RUN=true

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345
