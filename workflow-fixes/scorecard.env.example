# ==============================================================================
# Environment Configuration Template for scorecard.yml
# Workflow: OpenSSF Scorecard Supply-Chain Security
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io or 'native' on forks
# - native: GitHub-native SARIF generation, artifact archive, and step summary
# - original: Upstream OpenSSF API publishing
INPUT_MODE=auto

# Publish results to OpenSSF REST API (requires public repo & OIDC)
INPUT_PUBLISH_RESULTS=false

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345

# Optional fine-grained PAT with branch protection read permissions (if needed)
SECRET_SCORECARD_TOKEN=
