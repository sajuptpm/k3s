# govulncheck Workflow Configuration Template
# Workflow: .github/workflows/govulncheck.yml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Strict mode: fail the run if vulnerabilities exist (default false)
VARS_GOVULNCHECK_FAIL_ON_VULN=false

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_FAIL_ON_VULN=false
INPUT_PACKAGE=./...
INPUT_RUNNER=

# Secrets (None required)
