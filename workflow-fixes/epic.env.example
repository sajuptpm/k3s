# Update Epics Workflow Configuration Template
# Workflow: .github/workflows/epic.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_EPIC_LABEL=epic
INPUT_AUTO_CLOSE_EPIC=false
INPUT_RUNNER=

# Secrets (Uses standard GITHUB_TOKEN with issues: write scope)
