# E2E Test Coverage Workflow Configuration Template
# Workflow: .github/workflows/e2e.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Heavy push build control: false by default to prevent burning hours on commit pushes
VARS_ENABLE_HEAVY_PUSH_BUILDS=false

# Large runner label for scale testing (e.g. cncf-ubuntu-32-128-x86 or custom high-spec runner)
VARS_RUNNER_LARGE_LABEL=ubuntu-24.04

# Enable large/scale docker tests in fork
VARS_ENABLE_LARGE_TESTS=false

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_ETEST=startup
INPUT_DTEST=none
INPUT_RUNNER=
INPUT_SKIP_ARM64=true
INPUT_DRY_RUN=false

# Repository Secrets (Optional)
# CODECOV_TOKEN: Token for uploading test coverage to Codecov (gracefully skipped if absent)
CODECOV_TOKEN=
