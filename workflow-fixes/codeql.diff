+      id: analyze_native
       uses: github/codeql-action/analyze@b96794f015dfd88f77b49b1c93e0fa7110f94c63 # v4
+      continue-on-error: true
       with:
         category: "/language:${{matrix.language}}"
+        upload: ${{ inputs.upload_sarif != false }}
+        output: "results"
+
+    - name: Archive SARIF Results (Native Alternative)
+      if: steps.mode.outputs.resolved_mode == 'native' && always()
+      shell: bash
+      run: |
+        mkdir -p sarif-artifacts
+        if [ -d "results" ]; then
+          cp -r results/* sarif-artifacts/ 2>/dev/null || true
+        fi
+        find /home/runner/work/_temp -name "*.sarif" -exec cp {} sarif-artifacts/ \; 2>/dev/null || true
+        if [ ! "$(ls -A sarif-artifacts 2>/dev/null)" ]; then
