# ==============================================================================
# Environment Configuration Template for stale.yml
# Workflow: Stalebot Issues Management
# ==============================================================================

# Execution Mode: auto | native | original
# - auto: Dynamically select 'original' on k3s-io schedule or 'native' on forks/dispatch
# - native: GitHub-native dry-run (debug-only: true) without modifying issues
# - original: Live labeling and closing of stale issues
INPUT_MODE=auto

# Dry Run: debug-only execution (default: true for safety)
INPUT_DRY_RUN=true

# Days of inactivity before marking an issue stale
INPUT_DAYS_BEFORE_ISSUE_STALE=45

# Days of inactivity after marking an issue stale before closing it
INPUT_DAYS_BEFORE_ISSUE_CLOSE=14

# Optional custom GitHub Actions runner label (e.g. ubuntu-24.04, self-hosted)
VARS_RUNNER_LABEL=ubuntu-24.04
INPUT_RUNNER=ubuntu-24.04

# ------------------------------------------------------------------------------
# Secrets Configuration
# ------------------------------------------------------------------------------
# Automatic GitHub Token (provided by GitHub Actions environment)
GITHUB_TOKEN=ghp_exampleTokenForLocalCliTesting12345
