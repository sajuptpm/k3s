# Build K3s Workflow Configuration Template
# Workflow: .github/workflows/build-k3s.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom GitHub Actions runner label (default: ubuntu-24.04 or ubuntu-24.04-arm)
VARS_RUNNER_LABEL=ubuntu-24.04

# Workflow Dispatch Inputs
INPUT_PLATFORMS=linux/amd64
INPUT_UPLOAD_IMAGE=false
INPUT_UPLOAD_BUILD=false
INPUT_TEST_COVERAGE=false
INPUT_MODE=auto
INPUT_RUNNER=
INPUT_DRY_RUN=false

# Secrets (None required for build-k3s workflow)
