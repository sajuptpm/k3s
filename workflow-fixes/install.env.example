# Install Script Workflow Configuration Template
# Workflow: .github/workflows/install.yaml

# Repository Variables (Settings -> Secrets and variables -> Actions -> Variables)
# RUNNER_LABEL: Custom runner label (default: ubuntu-24.04)
VARS_RUNNER_LABEL=ubuntu-24.04

# Enable full automated push builds (default false)
VARS_ENABLE_HEAVY_PUSH_BUILDS=false

# Workflow Dispatch Inputs
INPUT_MODE=auto
INPUT_VM=ubuntu-2404
INPUT_RUN_DOCKER=true
INPUT_RUNNER=
INPUT_DRY_RUN=false

# Secrets (None required)
